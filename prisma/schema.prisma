// Prisma schema for Prompt Keeper

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Conversation {
  id               String  @id @default(cuid())
  model            String
  conversationHash String? @map("conversation_hash")
  // SHA-256 of the LiteLLM key that wrote the conversation. A continuation only matches conversations
  // of the same key, so one key holder can't rewrite another's history. Null on rows stored before.
  callerKeyHash    String? @map("caller_key_hash")

  latencyMs Float? @map("latency_ms")

  // Token usage
  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  // The request envelope with `messages` removed: tools offered, tool_choice, sampling params
  // and any client-specific extras. Without it a logged conversation is not reproducible.
  requestParams Json? @map("request_params")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages Message[]

  @@index([conversationHash])
  @@index([createdAt(sort: Desc)])
  @@index([model])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        Json

  // Tool calling: assistant messages carry toolCalls, tool messages carry toolCallId
  toolCalls  Json?   @map("tool_calls")
  toolCallId String? @map("tool_call_id")
  name       String?

  // LiteLLM-standardized reasoning fields
  reasoningContent String? @map("reasoning_content")
  thinkingBlocks   Json?   @map("thinking_blocks")

  // Assistant payloads beyond plain text
  annotations Json?
  audio       Json?
  images      Json?
  refusal     String?

  finishReason String? @map("finish_reason")
  messageIndex Int?    @map("message_index")

  createdAt DateTime @default(now()) @map("created_at")

  // Filled by a trigger from content, reasoning and tool names (see the add_postgres_search
  // migration); never written by the app. The client omits searchWords from every query
  // (src/lib/prisma.ts), and Prisma never selects an Unsupported field.
  searchWords String?                  @map("search_words")
  searchTsv  Unsupported("tsvector")? @map("search_tsv")
  searchLong Boolean                  @default(false) @map("search_long")

  @@index([conversationId])
  @@index([role, conversationId])
  @@index([searchTsv], type: Gin)
  @@index([searchWords(ops: raw("gin_trgm_ops"))], type: Gin, map: "messages_search_words_trgm_idx")
  // Partial (WHERE search_long), which Prisma can't express: declared so migrate dev keeps it
  @@index([searchWords(ops: raw("gin_trgm_ops"))], type: Gin, map: "messages_search_long_words_trgm_idx")
  @@map("messages")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  @@map("passkeys")
}

model OutboxEvent {
  id               String    @id @default(cuid())
  eventType        String    @map("event_type")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id")
  payload          Json?
  attempts         Int       @default(0)
  lockedAt         DateTime? @map("locked_at")
  lockId           String?   @map("lock_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  processedAt      DateTime? @map("processed_at")
  // The worker skips the event until then; set with exponential backoff after a failed attempt
  nextAttemptAt    DateTime? @map("next_attempt_at")
  // Attempts OpenSearch rejected the event itself (4xx). Outages and 5xx don't count
  rejectedAttempts Int       @default(0) @map("rejected_attempts")
  // Set after OUTBOX_MAX_ATTEMPTS rejected attempts; the worker stops retrying it
  deadLetteredAt   DateTime? @map("dead_lettered_at")
  lastError        String?   @map("last_error")

  @@index([processedAt, lockedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
