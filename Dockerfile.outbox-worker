# syntax=docker/dockerfile:1

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS base
ENV NODE_ENV=production

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies based on the preferred package manager
COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* .npmrc* ./
# postinstall runs `prisma generate`, which reads the schema and prisma.config.ts
COPY prisma/schema.prisma ./prisma/
COPY prisma.config.ts ./
RUN \
    if [ -f yarn.lock ]; then yarn --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci  --no-audit --no-fund; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --frozen-lockfile; \
    else echo "Lockfile not found." && exit 1; \
    fi

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Bundle the worker using esbuild. esbuild is a dev-only package, so the
# production `npm ci` above leaves it out and npx fetches it: pin it to the
# version the app's lockfile resolves (as Dockerfile.migrate does for prisma),
# so a release never builds with whatever esbuild is latest that day.
# We externalize all dependencies to keep the bundle small and avoid native module issues.
RUN version="$(node -p "require('./package-lock.json').packages['node_modules/esbuild'].version")" \
    && npx -y "esbuild@${version}" src/workers/outbox.ts \
    --bundle \
    --platform=node \
    --target=node24 \
    --outfile=dist/outbox.js \
    --packages=external \
    --sourcemap

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy node_modules from builder (production deps would be better but we reused deps which has all)
# To be cleaner we could have a separate prod-deps stage, but for now copying from builder is safe enough
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/dist/outbox.js ./dist/outbox.js
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json

USER nextjs

EXPOSE 3001

CMD ["node", "dist/outbox.js"]
