NODE_ENV="production"
LOG_LEVEL="info"

# Replace every change-me value before the first start: generate secrets with `openssl rand -hex 32`.
# These placeholders are public, so anything left unchanged is a credential anyone can use.

# LiteLLM Config
# LiteLLM requires the master key to start with "sk-"
LITELLM_MASTER_KEY="sk-change-me"
OPENAI_API_KEY="change-me"
ANTHROPIC_API_KEY="change-me"
DEEPSEEK_API_KEY="change-me"
GEMINI_API_KEY="change-me"
OPENROUTER_API_KEY="change-me"
LITELLM_URL="http://litellm:4000"

# Local Services Ports
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
LITELLM_PORT=4001
OPEN_WEBUI_PORT=8080

# OpenSearch
OPENSEARCH_URL="http://opensearch:9200"
OPENSEARCH_USERNAME="admin"
OPENSEARCH_PASSWORD="NotAGreatPassword2^"
OPENSEARCH_INDEX="prompt-keeper"

# Postgres
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@postgres:5432/prompt_keeper?schema=public
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@postgres:5432/prompt_keeper?schema=public

# Worker polling interval (ms) and batch size
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
# Failed attempts before an event is dead-lettered (outbox_events.dead_lettered_at) and no longer retried
OUTBOX_MAX_ATTEMPTS=10
# Optional worker shard id and total (for horizontal scaling)
WORKER_SHARD_ID=0
WORKER_SHARD_TOTAL=1

# Authentication (UI)
# Generate a secure random string for JWT signing

JWT_SECRET="your-jwt-secret-key-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-key-change-this-in-production"

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-at-least-32-chars-long

BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
BETTER_AUTH_SECRET=change-me

# Authentication (Prompt Keeper API)
# API key for direct API access (e.g., /api/search). A value starting with change-me is ignored.
PROMPT_KEEPER_API_KEY="change-me"

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "example.com,another.com")
CORS_ORIGIN="*"

# S3 (Minio)
S3_ENDPOINT=http://localhost:9000
# Also the MinIO root user and password in docker-compose.yml (the password needs 8+ characters)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=prompt-keeper

S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Auth
ENABLE_SIGNUP=false
