{
  "name": "prompt-keeper",
  "version": "0.13.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,worker\" -c \"cyan,magenta\" \"next dev --turbopack\" \"npm run dev:worker\"",
    "dev:https": "concurrently -n \"next,worker\" -c \"cyan,magenta\" \"next dev --turbopack --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem\" \"npm run dev:worker\"",
    "dev:next": "next dev --turbopack",
    "dev:worker": "tsx --env-file=.env src/workers/outbox.ts",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "generate-password": "node scripts/generate-password-hash.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js",
    "test:coverage": "jest --coverage --config jest.config.js",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint --edit",
    "worker:outbox": "node --env-file=.env ./dist/workers/outbox.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/passkey": "^1.7.10",
    "@opensearch-project/opensearch": "^3.9.0",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lru-cache": "^7.10.10",
    "apache-md5": "^1.1.8",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "jose": "^6.1.2",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.59.0",
    "motion": "14.3.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    },
    "sharp": "^0.35.0",
    "@hono/node-server": "^2.0.10",
    "fast-uri": "^3.1.4",
    "deepmerge-ts": "^8.0.2",
    "katex": "^0.18.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3",
    "@types/jest": "^30.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24",
    "@types/pino": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.2.0",
    "postcss": "^8",
    "shadcn": "^3.5.1",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typedoc": "0.28.20",
    "typescript": "^5"
  }
}
